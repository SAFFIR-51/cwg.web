# Copy to .env.local and fill in real values. NEVER commit the real file.
# 브랜드 파트너 문의 폼 → SMTP 메일 발송 (pages/api/contact.js)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
# Gmail App Password (16 chars). https://myaccount.google.com/apppasswords
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# 수신자 (쉼표로 여러 명)
MAIL_TO=your-account@gmail.com
MAIL_FROM_NAME=FULIF Brand Partner Inquiry

# 사이트 절대 주소 (OG 태그)
NEXT_PUBLIC_SITE_URL=https://fulif.io
# 스토어 링크
NEXT_PUBLIC_PLAY_URL=https://play.google.com/store/apps/details?id=com.cwg.fulif&hl=ko
NEXT_PUBLIC_APPSTORE_URL=https://apps.apple.com/kr/app/fulif/id6762817073
# 풀리 노트 네이버 블로그 (확정 시 입력)
NEXT_PUBLIC_BLOG_URL=
